# --- broker ---
RABBITMQ_USER=dailyops
RABBITMQ_PASS=dailyops

# --- gateway ---
MAX_CONCURRENCY=8          # RabbitMQ prefetch == max concurrent n8n executions
SUPPRESSION_WINDOW_S=300   # dedup suppression window (spec: 5 minutes)
RETRY_MAX=3

# --- n8n ---
N8N_ENCRYPTION_KEY=dailyops-dev-encryption-key-change-me

# --- grafana ---
GRAFANA_PASSWORD=admin

# --- notification channels (Workflow C) — leave empty for log-only mode
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=

# --- ticketing (Workflow B) — leave empty for mock ticket store
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=DOPS
