# --- postgres (single source of truth) ---
POSTGRES_USER=dailyops
POSTGRES_PASSWORD=dailyops
POSTGRES_DB=dailyops
DATABASE_URL=postgres://dailyops:dailyops@localhost:5435/dailyops

# --- agent-service (reasoning only) ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct

# --- auth (n8n -> agent-service): set a strong random value in production;
# leave empty for local dev (agent-service runs in open mode)
AGENT_API_KEY=
# DAILYOPS-OPS-2: set AGENT_SERVICE_ENV=production to fail-fast on boot if
# AGENT_API_KEY is empty. Leave as dev for local development.
AGENT_SERVICE_ENV=dev

# --- webhook auth (DAILYOPS-06): X-Webhook-Secret header on Business Event webhook
# + HMAC token on human approval links. Set a strong random value in production;
# leave empty for local dev (webhook guard runs in open mode)
WEBHOOK_SECRET=

# --- approval TTL in hours (DAILYOPS-04): PENDING approvals past TTL -> ESCALATED
APPROVAL_TTL_HOURS=24

# --- n8n ---
N8N_ENCRYPTION_KEY=dailyops-dev-encryption-key-change-me
# DAILYOPS-06 (R11): set to "production" to enforce DEV/PROD credential
# separation — init.sh refuses to import placeholder credentials.
N8N_DEPLOY_ENV=dev

# --- grafana ---
GRAFANA_PASSWORD=admin

# --- notification channels (NOTIFY actions) — leave empty for log-only mode
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
