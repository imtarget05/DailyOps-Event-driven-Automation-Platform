{
  "policies": [
    {
      "name": "pod-crashloop-auto-restart",
      "enabled": true,
      "description": "Pod crashloop in production + critical → auto restart",
      "condition": {
        "event_type": "service.alert",
        "severity": ["critical", "high"]
      },
      "decision": {
        "actions": ["auto_fix", "notify"],
        "auto_approve": true,
        "verify": true,
        "max_retries": 2
      },
      "safety": {
        "allowed_actions": ["restart_pod"],
        "dry_run": false
      }
    },
    {
      "name": "cpu-high-escalate",
      "enabled": true,
      "description": "CPU > 90% sustained — restart not allowed, escalate human",
      "condition": {
        "event_type": "service.alert",
        "alert": "cpu_high_usage",
        "severity": ["critical"]
      },
      "decision": {
        "actions": ["notify", "ticket"],
        "auto_approve": false,
        "verify": false,
        "escalate": true
      }
    },
    {
      "name": "memory-warning-suppress",
      "enabled": true,
      "description": "Memory warning in dev → suppress (noise)",
      "condition": {
        "event_type": "service.alert",
        "severity": ["warning"]
      },
      "decision": {
        "actions": [],
        "suppress": true,
        "reason": "dev noise"
      }
    },
    {
      "name": "default-notify",
      "enabled": true,
      "description": "Fallback — notify only",
      "condition": {},
      "decision": {
        "actions": ["notify"],
        "auto_approve": false
      }
    }
  ],
  "action_whitelist": {
    "restart_pod": { "allowed": true, "risk": "low" },
    "scale_deployment": { "allowed": true, "risk": "medium" },
    "rollback_deployment": { "allowed": true, "risk": "high" },
    "clear_cache": { "allowed": true, "risk": "low" },
    "restart_service": { "allowed": true, "risk": "low" },
    "delete_namespace": { "allowed": false, "risk": "critical" },
    "drop_database": { "allowed": false, "risk": "critical" },
    "modify_iam": { "allowed": false, "risk": "critical" }
  },
  "require_approval": ["rollback_deployment"],
  "dry_run": false
}
